{
  "apiVersion": 3,
  "name": "simplybook/widget",
  "title": "SimplyBook.me Booking Widget",
  "category": "widgets",
  "description": "Let visitors book your services online with SimplyBook.me.",
  "keywords": [
    "booking",
    "appointment",
    "calendar",
    "simplybook"
  ],
  "textdomain": "simplybook",
  "supports": {
    "multiple": false
  },
  "attributes": {
    "location": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "number",
      "default": 0
    },
    "service": {
      "type": "number",
      "default": 0
    },
    "provider": {
      "type": "string",
      "default": "0"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css"
}